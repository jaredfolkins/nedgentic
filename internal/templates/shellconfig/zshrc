NED_PROMPT_PREFIX="$(printf '\033[38;5;180m[\033[38;5;15m\342\214\220\033[38;5;251m\342\227\257\033[38;5;15m-\033[38;5;251m\342\227\257\033[38;5;180m]\033[0m')"
NED_PROMPT_USER=${USER:-${LOGNAME:-user}}
PROMPT="%{$NED_PROMPT_PREFIX%} %F{#ffd6a0}${NED_PROMPT_USER}@%m%f %F{#ffc57a}%~%f %F{#ffb066}%#%f "
